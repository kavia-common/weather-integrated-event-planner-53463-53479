# PUBLIC_INTERFACE
# Example environment variables required for live weather data.
# Copy this file to ".env" and fill in your real values. Do NOT commit your .env file.

# OpenWeatherMap current weather endpoint, e.g.:
# https://api.openweathermap.org/data/2.5/weather
REACT_APP_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# Your OpenWeatherMap API key
REACT_APP_WEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY
