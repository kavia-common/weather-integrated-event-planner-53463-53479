# PUBLIC_INTERFACE
# Environment variables for weather-integrated event planner frontend.
# Copy this file to .env and set values accordingly. Do NOT commit your actual .env.

# Base URL of your weather provider (e.g., OpenWeather current weather endpoint)
REACT_APP_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# API key for the provider
REACT_APP_WEATHER_API_KEY=YOUR_API_KEY_HERE

# The site URL (used by external services like Supabase emailRedirectTo if integrated later)
REACT_APP_SITE_URL=http://localhost:3000
