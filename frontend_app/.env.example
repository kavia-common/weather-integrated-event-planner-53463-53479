# Copy this file to .env in the same directory and fill in the values.
# Note: For Create React App, environment variables must be prefixed with REACT_APP_ to be exposed to the browser.

# PUBLIC_INTERFACE
# OpenWeatherMap current weather endpoint (MUST be the full endpoint path, not just the domain)
# Example: https://api.openweathermap.org/data/2.5/weather
REACT_APP_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# PUBLIC_INTERFACE
# Your OpenWeatherMap API key
REACT_APP_WEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
